{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/start_relay.py\"; python \"${CLAUDE_PLUGIN_ROOT}/scripts/start_relay.py\"; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8079/hook?where=pc",
            "timeout": 3,
            "headers": {
              "Authorization": "Bearer $WRISTLING_TOKEN"
            },
            "allowedEnvVars": [
              "WRISTLING_TOKEN"
            ]
          }
        ]
      }
    ],
